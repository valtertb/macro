# Skopíruj tento súbor na ".env" a doplň kľúč. Súbor .env nikdy nezdieľaj.

# POVINNÉ pre dáta z USA (zadarmo): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Port a adresa dashboardu (default: 127.0.0.1:3000 — iba lokálne)
PORT=3000

# Ako často sa dáta automaticky obnovujú (minúty). V dňoch s vydaním dát sa použije kratší interval.
REFRESH_MINUTES=60
RELEASE_DAY_REFRESH_MINUTES=15

# Cesta k SQLite databáze
DB_PATH=data/macro.sqlite
